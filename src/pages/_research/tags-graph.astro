---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildResearchPostUrl, getResearchPosts } from "@/utils/blog";
import { classifyPostTags } from "@/utils/blogTags";
import { researchTagCatalog } from "@/data/researchTagCatalog";
import { withBase } from "@/utils/paths";
import { cleanPostTitle } from "@/utils/title";

const posts = await getResearchPosts();
const topics = researchTagCatalog;
const GRAPH_GENERIC_KEYWORD_PENALTY: Record<string, number> = {
  nft: 0.46,
  web3: 0.62,
  區塊鏈: 0.7,
  加密: 0.7,
};

const items = posts.map((post) => {
  const classified = classifyPostTags({
    title: cleanPostTitle(post.data.title),
    description: post.data.description,
    body: post.body,
    tags: post.data.tags,
    category: post.data.category ?? undefined,
    catalog: researchTagCatalog,
  });
  return {
    id: `post:${post.id}`,
    title: cleanPostTitle(post.data.title),
    url: buildResearchPostUrl(post),
    topics: classified.topics,
    keywords: classified.keywords.slice(0, 6),
    secondaryKeywords: classified.secondaryKeywords.slice(0, 10),
    keywordScores: classified.keywordScores.slice(0, 20),
  };
});

const keywordCounter = new Map<string, { label: string; score: number; df: number }>();
for (const item of items) {
  const seenKeywords = new Set<string>();
  for (const keyword of item.keywordScores) {
    const key = keyword.keyword.trim().toLocaleLowerCase("zh-TW");
    if (!key) continue;
    const bucket = keywordCounter.get(key) ?? { label: keyword.keyword, score: 0, df: 0 };
    const tierBonus = keyword.tier === "primary" ? 1.12 : 0.9;
    bucket.score += keyword.score * tierBonus;
    if (keyword.keyword.length > bucket.label.length) bucket.label = keyword.keyword;
    if (!seenKeywords.has(key)) {
      bucket.df += 1;
      seenKeywords.add(key);
    }
    keywordCounter.set(key, bucket);
  }
}

const topKeywords = Array.from(keywordCounter.entries())
  .filter(([, stat]) => stat.df >= 1) // Research might have fewer posts, so lowering threshold
  .map(([norm, stat]) => {
    const idf = Math.log(1 + items.length / (1 + stat.df));
    const overlyCommonPenalty = stat.df / (items.length || 1) > 0.5 ? 0.42 : 1;
    const genericPenalty = GRAPH_GENERIC_KEYWORD_PENALTY[norm] ?? 1;
    const raritySmoothing = Math.sqrt(stat.df);
    const weighted = stat.score * idf * raritySmoothing * overlyCommonPenalty * genericPenalty;
    return [stat.label, weighted] as const;
  })
  .sort((a, b) => b[1] - a[1])
  .slice(0, 56)
  .map(([keyword]) => keyword);

const keywordSet = new Set(topKeywords);

const nodes: Array<{
  id: string;
  type: "topic" | "keyword" | "post";
  label: string;
  url?: string;
  topic?: string;
}> = [];
const links: Array<{ source: string; target: string; kind: "topic" | "keyword"; weight: number }> =
  [];

// 統一 ID 正規化函式 (Node.js 端)
function normNodeId(type: string, key: string) {
  const cleanKey = key.trim().toLocaleLowerCase("zh-TW");
  return `${type}:${cleanKey}`;
}

for (const topic of topics) {
  nodes.push({ id: normNodeId("topic", topic.key), type: "topic", label: topic.title, topic: topic.key });
}

for (const keyword of topKeywords) {
  nodes.push({ id: normNodeId("keyword", keyword), type: "keyword", label: keyword });
}

for (const item of items) {
  nodes.push({
    id: item.id,
    type: "post",
    label: item.title,
    url: item.url,
    topic: item.topics[0],
  });
  
  for (const topicKey of item.topics) {
    links.push({ source: item.id, target: normNodeId("topic", topicKey), kind: "topic", weight: 1 });
  }
  
  for (const keywordEntry of item.keywordScores) {
    const normKey = keywordEntry.keyword.trim().toLocaleLowerCase("zh-TW");
    const isTopKeyword = topKeywords.some(tk => tk.trim().toLocaleLowerCase("zh-TW") === normKey);
    
    if (isTopKeyword) {
      const linkWeight =
        keywordEntry.tier === "primary"
          ? Math.min(1.8, Math.max(0.55, keywordEntry.score / 2.2))
          : Math.min(1.3, Math.max(0.35, keywordEntry.score / 2.8));
      links.push({
        source: item.id,
        target: normNodeId("keyword", keywordEntry.keyword),
        kind: "keyword",
        weight: Number(linkWeight.toFixed(3)),
      });
    }
  }
}

const graph = { nodes, links };
---

<BaseLayout
  title="研究資料關聯圖 (站中站)"
  description="專屬於研究文稿的標籤與主題關聯地圖。"
  noindex={true}
>
  <h1 class="section-title graph-page-title">研究資料關聯圖</h1>
  <p class="graph-intro">這是專屬於研究文稿的私密關聯圖，探索研究主題之間的脈絡。</p>

  <section class="graph-panel" aria-label="研究關聯圖">
    <div class="graph-toolbar">
      <label>
        篩選主題
        <select id="graph-topic-filter">
          <option value="all">全部主題</option>
          {topics.map((t) => <option value={t.key}>{t.title}</option>)}
        </select>
      </label>
      <label>
        查找節點
        <input id="graph-search" type="search" placeholder="輸入文章或關鍵字" />
      </label>
      <button id="graph-reset" type="button">重置視視角</button>
    </div>
    <div class="graph-guide" aria-label="使用說明">
      <p class="graph-guide-text">拖曳旋轉、滾輪縮放；文章節點點一次看資訊、再點一次開啟研究室。</p>
      <p id="graph-search-status" class="graph-search-status" aria-live="polite">
        搜尋結果：全部節點
      </p>
      <div class="graph-type-toggle" role="group" aria-label="節點類型顯示">
        <label>
          <input type="checkbox" data-node-type="topic" checked />
          <span class="graph-legend-dot graph-legend-dot-topic"></span>
          主題
        </label>
        <label>
          <input type="checkbox" data-node-type="keyword" checked />
          <span class="graph-legend-dot graph-legend-dot-keyword"></span>
          關鍵字
        </label>
        <label>
          <input type="checkbox" data-node-type="post" checked />
          <span class="graph-legend-dot graph-legend-dot-post"></span>
          研究文稿
        </label>
      </div>
    </div>
    <div class="graph-main">
      <div
        id="graph-stage"
        class="graph-stage"
        role="application"
        aria-label="互動圖譜"
        tabindex="0"
      >
      </div>
      <aside
        id="graph-inspector"
        class="graph-inspector"
        aria-live="polite"
        aria-label="節點資訊面板"
      >
        <div class="graph-inspector-head">
          <h2>節點資訊</h2>
          <button
            id="graph-inspector-close"
            type="button"
            class="graph-inspector-close"
            aria-label="關閉資訊面板">關閉</button
          >
        </div>
        <div id="graph-inspector-content" class="graph-inspector-content">
          <p>點擊任一節點查看詳細資訊。</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ graph }}>
  // 這裡複用原本 tags-graph.astro 的 JS 邏輯，但移除了全站搜尋索引的加載
  // 為了簡潔，我會包含核心的 D3-like 渲染邏輯
  const stage = document.querySelector("#graph-stage");
  const inspector = document.querySelector("#graph-inspector");
  const inspectorContent = document.querySelector("#graph-inspector-content");
  const inspectorClose = document.querySelector("#graph-inspector-close");
  const topicFilter = document.querySelector("#graph-topic-filter");
  const searchInput = document.querySelector("#graph-search");
  const searchStatus = document.querySelector("#graph-search-status");
  const resetButton = document.querySelector("#graph-reset");
  const typeCheckboxes = Array.from(
    document.querySelectorAll(".graph-type-toggle input[data-node-type]"),
  );

  if (!(stage instanceof HTMLElement)) throw new Error("graph stage missing");

  const nodes = graph.nodes.map((n, idx) => ({
    ...n,
    i: idx,
    x: (Math.random() - 0.5) * 640,
    y: (Math.random() - 0.5) * 420,
    z: (Math.random() - 0.5) * 340,
    vx: 0,
    vy: 0,
    vz: 0,
  }));

  const byId = new Map(nodes.map((n) => [n.id, n]));
  const links = graph.links
    .map((link) => ({ ...link, s: byId.get(link.source), t: byId.get(link.target) }))
    .filter((link) => link.s && link.t);

  const topicToPosts = new Map();
  const keywordToPosts = new Map();
  const postToTopics = new Map();
  const postToKeywords = new Map();
  const postToKeywordWeights = new Map();
  const adjacency = new Map();

  function pushMapSet(map, key, value) {
    const set = map.get(key);
    if (set) {
      set.add(value);
      return;
    }
    map.set(key, new Set([value]));
  }

  function pushKeywordWeight(postId, keywordId, weight) {
    const bucket = postToKeywordWeights.get(postId);
    if (bucket) {
      bucket.set(keywordId, Math.max(weight, bucket.get(keywordId) ?? 0));
      return;
    }
    postToKeywordWeights.set(postId, new Map([[keywordId, weight]]));
  }

  function pushAdjacency(a, b) {
    const setA = adjacency.get(a);
    if (setA) setA.add(b);
    else adjacency.set(a, new Set([b]));
    const setB = adjacency.get(b);
    if (setB) setB.add(a);
    else adjacency.set(b, new Set([a]));
  }

  for (const link of links) {
    pushAdjacency(link.s.id, link.t.id);
    if (link.kind === "topic") {
      // 確保 post 與 topic 的雙向映射
      if (link.s.type === "post" && link.t.type === "topic") {
        pushMapSet(topicToPosts, link.t.id, link.s);
        pushMapSet(postToTopics, link.s.id, link.t.id);
      } else if (link.s.type === "topic" && link.t.type === "post") {
        pushMapSet(topicToPosts, link.s.id, link.t);
        pushMapSet(postToTopics, link.t.id, link.s.id);
      }
    }
    if (link.kind === "keyword") {
      if (link.s.type === "post" && link.t.type === "keyword") {
        pushMapSet(postToKeywords, link.s.id, link.t.id);
        pushMapSet(keywordToPosts, link.t.id, link.s);
        pushKeywordWeight(link.s.id, link.t.id, Number(link.weight ?? 1));
      }
    }
  }

  const svgNS = "http://www.w3.org/2000/svg";
  const svg = document.createElementNS(svgNS, "svg");
  svg.classList.add("graph-links");
  stage.appendChild(svg);

  const nodesLayer = document.createElement("div");
  nodesLayer.className = "graph-nodes";
  stage.appendChild(nodesLayer);

  const linkEls = links.map((link) => {
    const el = document.createElementNS(svgNS, "line");
    el.setAttribute("class", `graph-link graph-link-${link.kind}`);
    const weight = Number(link.weight ?? 1);
    if (link.kind === "keyword") {
      el.style.strokeWidth = `${(0.8 + weight * 0.9).toFixed(2)}`;
      el.style.strokeOpacity = `${Math.min(0.82, 0.28 + weight * 0.28)}`;
    } else {
      el.style.strokeWidth = "1.35";
    }
    svg.appendChild(el);
    return el;
  });

  const nodeEls = nodes.map((node) => {
    const el = document.createElement("button");
    el.type = "button";
    el.className = `graph-node graph-node-${node.type}`;
    el.textContent = node.type === "post" ? "" : node.label;
    el.title = node.label;
    nodesLayer.appendChild(el);
    return el;
  });

  function escapeHtml(text) {
    return text
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  let selectedNodeId = "";
  let lastSelectedNodeId = "";
  let lastSelectedAt = 0;
  let centerNodeId = "";
  let viewOffsetX = 0;
  let viewOffsetY = 0;
  let yaw = 0;
  let pitch = 0;
  let zoom = 1;
  let dragging = false;
  let pointerMoved = false;
  let dragPointerId = -1;
  const dragThreshold = 6;
  let lx = 0;
  let ly = 0;
  const visibleTypes = new Set(["topic", "keyword", "post"]);
  let visibleNodeIds = new Set(nodes.map((n) => n.id));
  let visibleLinkFlags = links.map(() => true);
  let focusNodeIds = new Set();
  const defaultInspectorHtml = "<p>點擊任一節點查看詳細資訊。</p>";

  function setSelectedNode(nodeId) {
    selectedNodeId = nodeId;
    centerNodeId = nodeId;
    nodeEls.forEach((el, i) => {
      const selected = nodes[i].id === nodeId;
      el.classList.toggle("graph-node-selected", selected);
    });
    inspector?.classList.toggle("graph-inspector-open", Boolean(nodeId));
  }

  function renderRelatedPostCards(posts) {
    if (posts.length === 0) return '<p class="graph-info-empty">目前沒有對應研究文稿。</p>';
    return `<ul class="graph-inspector-card-list">${posts
      .slice(0, 50)
      .map(p => `
        <li class="graph-inspector-card-item">
          <button type="button" class="graph-inspector-card-link" data-focus-node-id="${escapeHtml(p.id)}">${escapeHtml(p.label)}</button>
        </li>
      `).join("")}</ul>`;
  }

  function renderInspector(node) {
    if (!(inspectorContent instanceof HTMLElement)) return;
    if (node.type === "topic") {
      const posts = Array.from(topicToPosts.get(node.id) ?? []).sort((a, b) => a.label.localeCompare(b.label, "zh-Hant"));
      inspectorContent.innerHTML = `
        <article class="graph-info-card">
          <div class="graph-info-head">
            <h3>${escapeHtml(node.label)}</h3>
            <span class="graph-info-type">主題</span>
          </div>
          <p class="graph-info-count">關聯研究文稿 ${posts.length} 篇</p>
          <div class="graph-inspector-scroll">${renderRelatedPostCards(posts)}</div>
        </article>
      `;
    } else if (node.type === "post") {
      inspectorContent.innerHTML = `
        <article class="graph-post-card">
          <div class="graph-post-card-head">
            <span class="graph-post-card-type">研究文稿</span>
          </div>
          <a class="graph-post-card-link" href="${node.url}">${escapeHtml(node.label)}</a>
        </article>
      `;
    } else {
      const posts = Array.from(keywordToPosts.get(node.id) ?? []).sort((a, b) => a.label.localeCompare(b.label, "zh-Hant"));
      inspectorContent.innerHTML = `
        <article class="graph-info-card">
          <div class="graph-info-head">
            <h3>${escapeHtml(node.label)}</h3>
            <span class="graph-info-type">關鍵字</span>
          </div>
          <p class="graph-info-count">關聯研究文稿 ${posts.length} 篇</p>
          <div class="graph-inspector-scroll">${renderRelatedPostCards(posts)}</div>
        </article>
      `;
    }
  }

  inspectorContent?.addEventListener("click", (e) => {
    const target = e.target;
    if (!(target instanceof HTMLElement)) return;
    const btn = target.closest("[data-focus-node-id]");
    if (btn instanceof HTMLElement) {
      const id = btn.dataset.focusNodeId;
      if (id) { setSelectedNode(id); renderInspector(byId.get(id)); applyFilters(); }
    }
  });

  function applyFilters() {
    const selectedTopicValue = topicFilter instanceof HTMLSelectElement ? topicFilter.value : "all";
    const selectedTopicId = selectedTopicValue !== "all" ? `topic:${selectedTopicValue}` : "all";
    const q = (searchInput instanceof HTMLInputElement ? searchInput.value : "").trim().toLocaleLowerCase("zh-TW");

    visibleNodeIds = new Set();
    const queryFocusNodeIds = new Set();
    
    // 如果有選取下拉主題，預先找出該主題及相關文章，並包含其相關的關鍵字
    if (selectedTopicId !== "all") {
      queryFocusNodeIds.add(selectedTopicId);
      const postsInTopic = topicToPosts.get(selectedTopicId) ?? new Set();
      postsInTopic.forEach(p => {
        queryFocusNodeIds.add(p.id);
        const kws = postToKeywords.get(p.id) ?? new Set();
        kws.forEach(kid => queryFocusNodeIds.add(kid));
      });
    }

    const activeFocusNodeIds = new Set();
    if (selectedNodeId) {
      activeFocusNodeIds.add(selectedNodeId);
      const adj = adjacency.get(selectedNodeId) ?? new Set();
      adj.forEach(id => activeFocusNodeIds.add(id));
      // 若點擊的是主題，也將該主題下文章的對應關鍵字納入 Focus
      if (selectedNodeId.startsWith("topic:")) {
        const posts = topicToPosts.get(selectedNodeId) ?? new Set();
        posts.forEach(p => {
          const kws = postToKeywords.get(p.id) ?? new Set();
          kws.forEach(kid => activeFocusNodeIds.add(kid));
        });
      }
    }

    focusNodeIds = selectedNodeId ? activeFocusNodeIds : queryFocusNodeIds;
    let matchCount = 0;

    nodeEls.forEach((el, i) => {
      const n = nodes[i];
      let topicVisible = selectedTopicId === "all" || n.id === selectedTopicId || (n.type === "post" && postToTopics.get(n.id)?.has(selectedTopicId)) || (n.type === "keyword" && Array.from(keywordToPosts.get(n.id) ?? []).some(p => postToTopics.get(p.id)?.has(selectedTopicId)));
      const typeVisible = visibleTypes.has(n.type);

      if (!topicVisible || !typeVisible) {
        el.style.opacity = "0";
        el.style.pointerEvents = "none";
        return;
      }

      visibleNodeIds.add(n.id);
      const matched = !q || n.label.toLocaleLowerCase("zh-TW").includes(q);
      if (matched) matchCount++;
      const inFocus = focusNodeIds.size === 0 || focusNodeIds.has(n.id);
      let opacity = matched ? 1 : 0.2;
      // 降低非 focus 節點的不透明度，凸顯主脈絡，原本是 0.3 改為 0.15 讓孤島淡出
      if (!inFocus) opacity *= 0.15;
      el.style.opacity = String(opacity);
      el.style.pointerEvents = "auto";
    });

    linkEls.forEach((el, i) => {
      const link = links[i];
      const linkVisible = visibleNodeIds.has(link.s.id) && visibleNodeIds.has(link.t.id);
      el.style.display = linkVisible ? "block" : "none";
      if (linkVisible) {
        const inFocus = focusNodeIds.size === 0 || (focusNodeIds.has(link.s.id) && focusNodeIds.has(link.t.id));
        el.style.strokeOpacity = inFocus ? "0.8" : "0.05";
      }
    });

    if (searchStatus) searchStatus.textContent = q ? `搜尋結果：${matchCount} / ${visibleNodeIds.size}` : `搜尋結果：全部節點（${visibleNodeIds.size}）`;
  }

  function project(n, w, h) {
    const cy = Math.cos(yaw), sy = Math.sin(yaw), cp = Math.cos(pitch), sp = Math.sin(pitch);
    const x1 = n.x * cy - n.z * sy, z1 = n.x * sy + n.z * cy, y1 = n.y * cp - z1 * sp, z2 = n.y * sp + z1 * cp;
    const p = (760 / (760 + z2)) * zoom;
    return { x: w / 2 + x1 * p, y: h / 2 + y1 * p, s: Math.max(0.3, p), z: z2 };
  }

  function applyForces() {
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i], b = nodes[j];
        const dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
        const d2 = dx * dx + dy * dy + dz * dz + 0.1;
        const f = 2000 / d2;
        const inv = 1 / Math.sqrt(d2);
        a.vx += dx * inv * f; a.vy += dy * inv * f; a.vz += dz * inv * f;
        b.vx -= dx * inv * f; b.vy -= dy * inv * f; b.vz -= dz * inv * f;
      }
    }
    for (const link of links) {
      const a = link.s, b = link.t;
      const dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
      const d = Math.sqrt(dx * dx + dy * dy + dz * dz) || 1;
      const f = (d - (link.kind === "topic" ? 140 : 180)) * 0.02;
      a.vx += (dx / d) * f; a.vy += (dy / d) * f; a.vz += (dz / d) * f;
      b.vx -= (dx / d) * f; b.vy -= (dy / d) * f; b.vz -= (dz / d) * f;
    }
  }

  function frame() {
    applyForces();
    for (const n of nodes) {
      n.vx *= 0.9; n.vy *= 0.9; n.vz *= 0.9;
      n.x += n.vx; n.y += n.vy; n.z += n.vz;
    }
    const rect = stage.getBoundingClientRect();
    const p = nodes.map(n => project(n, rect.width, rect.height));
    
    if (centerNodeId && !dragging) {
      const fn = byId.get(centerNodeId), pf = fn ? p[fn.i] : null;
      if (pf) {
        viewOffsetX += (rect.width/2 - pf.x - viewOffsetX) * 0.1;
        viewOffsetY += (rect.height/2 - pf.y - viewOffsetY) * 0.1;
      }
    } else {
      viewOffsetX *= 0.9; viewOffsetY *= 0.9;
    }

    links.forEach((l, i) => {
      const el = linkEls[i];
      if (el.style.display === "none") return;
      const a = p[l.s.i], b = p[l.t.i];
      el.setAttribute("x1", a.x + viewOffsetX); el.setAttribute("y1", a.y + viewOffsetY);
      el.setAttribute("x2", b.x + viewOffsetX); el.setAttribute("y2", b.y + viewOffsetY);
    });

    nodes.forEach((_, i) => {
      const el = nodeEls[i], pp = p[i];
      el.style.left = `${pp.x + viewOffsetX}px`; el.style.top = `${pp.y + viewOffsetY}px`;
      el.style.transform = `translate(-50%, -50%) scale(${pp.s})`;
      el.style.zIndex = Math.round(pp.z + 1000);
    });
    requestAnimationFrame(frame);
  }

  stage.addEventListener("pointerdown", e => {
    if (e.target.closest(".graph-node")) return;
    dragging = true; pointerMoved = false; dragPointerId = e.pointerId;
    lx = e.clientX; ly = e.clientY; stage.setPointerCapture(e.pointerId);
  });
  stage.addEventListener("pointermove", e => {
    if (!dragging || e.pointerId !== dragPointerId) return;
    const dx = e.clientX - lx, dy = e.clientY - ly;
    if (Math.hypot(dx, dy) > dragThreshold) pointerMoved = true;
    yaw += dx * 0.005; pitch += dy * 0.005; lx = e.clientX; ly = e.clientY;
  });
  stage.addEventListener("pointerup", e => { dragging = false; });
  stage.addEventListener("wheel", e => { e.preventDefault(); zoom = Math.min(2.5, Math.max(0.4, zoom + (e.deltaY < 0 ? 0.1 : -0.1))); }, { passive: false });

  topicFilter?.addEventListener("change", () => { setSelectedNode(""); applyFilters(); });
  searchInput?.addEventListener("input", () => { applyFilters(); });
  typeCheckboxes.forEach(cb => cb.addEventListener("change", () => {
    const type = cb.dataset.nodeType;
    if (cb.checked) visibleTypes.add(type); else visibleTypes.delete(type);
    applyFilters();
  }));

  nodeEls.forEach((el, i) => {
    el.addEventListener("click", () => {
      const node = nodes[i];
      const wasSelected = selectedNodeId === node.id;
      const rapidSecondTap = wasSelected && performance.now() - lastSelectedAt < 800;
      setSelectedNode(node.id); renderInspector(node); applyFilters();
      lastSelectedAt = performance.now();
      if (node.url && rapidSecondTap) window.location.href = node.url;
    });
  });

  inspectorClose?.addEventListener("click", () => { setSelectedNode(""); applyFilters(); });
  resetButton?.addEventListener("click", () => { yaw=0; pitch=0; zoom=1; applyFilters(); });

  let rect = stage.getBoundingClientRect();
  const ro = new ResizeObserver(() => {
    rect = stage.getBoundingClientRect();
    svg.setAttribute("viewBox", `0 0 ${rect.width} ${rect.height}`);
  });
  ro.observe(stage);

  console.log("[research-graph] init with", nodes.length, "nodes,", links.length, "links");
  applyFilters();
  frame();
</script>

