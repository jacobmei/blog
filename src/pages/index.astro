---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import { getBlogPosts } from "@/utils/blog";
import { withBase } from "@/utils/paths";
import mottos from "@/data/motto.json";

const posts = await getBlogPosts();
const latestPosts = posts.slice(0, 8);
const randomMotto = mottos[Math.floor(Math.random() * mottos.length)];

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "關於小梅子 / Jacob Mei Labs 的研究核心為何？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "核心研究範疇涵蓋電子支付、數位金融法規、Web3 治理架構以及人工智慧代理（AI Agents）的實踐，同時記錄個人的信仰生活與思考。"
      }
    },
    {
      "@type": "Question",
      "name": "如何聯繫 Jacob Mei？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "您可以透過電子郵件 sitedirector@gmail.com 進行聯繫，或造訪網站的聯繫頁面獲取更多社交媒體資訊。"
      }
    },
    {
      "@type": "Question",
      "name": "這個網站（實驗室）的願景是什麼？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "建立一個永續的個人知識庫，並透過數位實踐探索科技與人類社會、信仰之間的交構與治理可能性。"
      }
    }
  ]
};
---

<BaseLayout 
  description="此身譬如朝露易逝，終究難留；幾番波折方知，人生似夢一場。"
  structuredData={faqData}
>
  <section class="home-hero-grid" aria-label="首頁引言">
    <section class="hero">
      <figure style="margin:0;">
        <blockquote class="hero-text" style="margin:0;">
          <p style="margin:0;" id="motto-text">{randomMotto.text}</p>
        </blockquote>
        <figcaption class="hero-kicker" id="motto-source">{randomMotto.source}</figcaption>
      </figure>
    </section>
  </section>

  <aside
    id="continue-reading-toast"
    class="continue-reading-toast"
    hidden
    aria-label="繼續閱讀通知"
  >
    <button
      id="continue-reading-close"
      class="continue-reading-close"
      type="button"
      aria-label="關閉繼續閱讀通知"
    >
      關閉
    </button>
    <a id="continue-reading-link" class="continue-reading-link" href={withBase("blog/")}>
      <strong id="continue-reading-title">繼續閱讀</strong>
      <span id="continue-reading-meta">進度 0%</span>
    </a>
  </aside>

  <div class="home-section-head">
    <h2 class="section-title">最新文章</h2>
    <p class="home-section-meta">最近更新 {latestPosts.length} 篇</p>
  </div>
  {
    latestPosts.length === 0 ? (
      <p class="empty-state">目前還沒有文章。</p>
    ) : (
      <section class="home-post-grid" aria-label="近期更新">
        <ul class="post-list post-list-compact-grid">
          {latestPosts.map((post) => (
            <li>
              <PostCard post={post} variant="compact" minimal={true} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p class="home-all-link">
    <a href={withBase("blog/")}>查看全部文章 -></a>
  </p>
</BaseLayout>

<script is:inline>
  const section = document.querySelector("#continue-reading-toast");
  const closeButton = document.querySelector("#continue-reading-close");
  const link = document.querySelector("#continue-reading-link");
  const title = document.querySelector("#continue-reading-title");
  const meta = document.querySelector("#continue-reading-meta");
  const key = "jacobmei.blog.lastReading";
  const dismissPrefix = "jacobmei.blog.lastReading.dismissed.";

  try {
    const raw = localStorage.getItem(key);
    if (!raw) throw new Error("empty");
    const data = JSON.parse(raw);
    if (!data || typeof data.url !== "string" || typeof data.title !== "string") {
      throw new Error("invalid");
    }

    if (link instanceof HTMLAnchorElement) {
      link.href = data.url;
    }
    if (title instanceof HTMLElement) {
      title.textContent = `繼續閱讀｜${data.title}`;
    }
    if (meta instanceof HTMLElement) {
      const progress =
        typeof data.progress === "number" ? Math.max(0, Math.min(100, data.progress)) : 0;
      meta.textContent = `進度 ${progress}%`;
    }
    const dismissKey = `${dismissPrefix}${data.url}::${data.title}`;
    const dismissed = localStorage.getItem(dismissKey) === "1";
    if (section instanceof HTMLElement && !dismissed) {
      section.hidden = false;
      section.dataset.dismissKey = dismissKey;
    }
  } catch {
    if (section instanceof HTMLElement) section.hidden = true;
  }

  closeButton?.addEventListener("click", () => {
    if (!(section instanceof HTMLElement)) return;
    section.hidden = true;
    const dismissKey = section.dataset.dismissKey;
    if (dismissKey) {
      localStorage.setItem(dismissKey, "1");
    }
  });
</script>

<script is:inline define:vars={{ mottos }}>
  (function () {
    const textEl = document.getElementById("motto-text");
    const sourceEl = document.getElementById("motto-source");
    if (textEl && sourceEl && Array.isArray(mottos) && mottos.length > 0) {
      const idx = Math.floor(Math.random() * mottos.length);
      const random = mottos[idx];
      textEl.textContent = random.text;
      sourceEl.textContent = random.source;
    }
  })();
</script>
