---
import { ethers } from "ethers";
import type { EnsResolution } from "@/utils/ens";

interface Props {
  ensName: string;
  chainId: number;
  ens: EnsResolution;
}

const { ensName, chainId, ens } = Astro.props;

const tipAddress = ens.resolvedAddress ?? "";
const tipTarget = tipAddress || ensName;
const tipAmountNtd = 100;
const fallbackTipAmountEth = 0.001;
const fallbackTipAmountEthText = fallbackTipAmountEth.toFixed(3);

const toEip681 = (valueEth: string): string => {
  const valueWei = ethers.utils.parseEther(valueEth).toString();
  return `ethereum:${tipTarget}@${chainId}?value=${valueWei}`;
};

const defaultPaymentURI = toEip681(fallbackTipAmountEthText);
const defaultQrUrl = `https://quickchart.io/qr?text=${encodeURIComponent(defaultPaymentURI)}&size=240`;
---

<details class="tip-jar-disclosure toc-share-card">
  <summary class="toc-share-btn tip-jar-summary">抖內抖泥</summary>
  <section class="tip-jar" aria-label="打賞">
    <p class="tip-jar-line tip-ens-row">
      <span class="tip-ens-text">
        ENS：<code class="tip-ens-name">{ensName}</code>
      </span>
      {
        ens.isVerified ? (
          <span class="tip-verified-inline" aria-label="已驗證" title="已驗證">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.75a9.25 9.25 0 1 0 0 18.5 9.25 9.25 0 0 0 0-18.5Zm-1.4 12.1-2.7-2.72 1.2-1.2 1.5 1.52 4.23-4.22 1.2 1.2-5.43 5.42Z"></path>
            </svg>
          </span>
        ) : (
          <span class="tip-status-inline">待驗證</span>
        )
      }
    </p>
    {
      ens.error && (
        <p class="tip-jar-line tip-warning">ENS 解析異常：{ens.error}</p>
      )
    }
    {!ens.isVerified && !ens.error && (
      <p class="tip-jar-line tip-warning">ENS 提示：{ens.verificationMessage}</p>
    )}

    <div class="tip-actions">
      <button
        type="button"
        class="tip-pay-btn"
        data-tip-pay-btn
        data-tip-address={tipAddress}
        data-tip-target={tipTarget}
        data-tip-chain-id={String(chainId)}
        data-tip-ntd={String(tipAmountNtd)}
        data-tip-default-eth={fallbackTipAmountEthText}
        data-tip-default-label={`用以太幣抖內（約 NT$${tipAmountNtd}）`}
        data-tip-fallback-label={`改用錢包連結抖內（約 NT$${tipAmountNtd}）`}
      >
        用以太幣抖內（約 NT$100）
      </button>
      <p class="tip-pay-feedback" data-tip-pay-feedback aria-live="polite" hidden></p>
    </div>

    <div class="tip-fallback" data-tip-fallback hidden>
      <p class="tip-qr-caption">掃碼抖內</p>
      <a class="tip-qr-link" data-tip-fallback-link href={defaultPaymentURI} aria-label="打開錢包付款請求">
        <img
          data-tip-fallback-qr
          src={defaultQrUrl}
          alt="打賞付款 QR code"
          width="180"
          height="180"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </section>
</details>

<script is:inline>
  const tipRoot = document.currentScript?.previousElementSibling;
  const payButton = tipRoot?.querySelector("[data-tip-pay-btn]");
  const feedback = tipRoot?.querySelector("[data-tip-pay-feedback]");
  const fallbackBox = tipRoot?.querySelector("[data-tip-fallback]");
  const fallbackLinks = tipRoot?.querySelectorAll("[data-tip-fallback-link]");
  const fallbackQr = tipRoot?.querySelector("[data-tip-fallback-qr]");
  const track = (name, props = {}) => {
    if (typeof window.mbTrack === "function") {
      window.mbTrack(name, props);
    }
  };

  const formatEthAmount = (value) => {
    const fixed = Number(value).toFixed(8);
    return fixed.replace(/0+$/, "").replace(/\.$/, "");
  };

  const ethTextToWeiDecimal = (ethText) => {
    const [intPartRaw, fracPartRaw = ""] = String(ethText).split(".");
    const intPart = intPartRaw || "0";
    const fracPart = (fracPartRaw + "000000000000000000").slice(0, 18);
    return (BigInt(intPart) * 10n ** 18n + BigInt(fracPart)).toString();
  };

  const isHexAddress = (value) => /^0x[a-fA-F0-9]{40}$/.test(value);

  const fetchEthTwdRate = async () => {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 3500);

    try {
      const response = await fetch("https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=twd", {
        headers: { accept: "application/json" },
        signal: controller.signal
      });
      if (!response.ok) return null;
      const payload = await response.json();
      const rate = Number(payload?.ethereum?.twd);
      if (!Number.isFinite(rate) || rate <= 0) return null;
      return rate;
    } catch {
      return null;
    } finally {
      clearTimeout(timeout);
    }
  };

  const buildPaymentPlan = async ({ target, chainId, ntdAmount, fallbackEth }) => {
    let ethAmount = fallbackEth;
    let rateText = "匯率服務暫不可用，已用預設估算";

    const rate = await fetchEthTwdRate();
    if (rate) {
      ethAmount = ntdAmount / rate;
      rateText = `依即時匯率估算（1 ETH ≈ NT$${Math.round(rate).toLocaleString("zh-TW")}）`;
    }

    const ethText = formatEthAmount(ethAmount);
    const weiDecimal = ethTextToWeiDecimal(ethText);
    const weiHex = `0x${BigInt(weiDecimal).toString(16)}`;
    const paymentUri = `ethereum:${target}@${chainId}?value=${weiDecimal}`;
    const qrUrl = `https://quickchart.io/qr?text=${encodeURIComponent(paymentUri)}&size=240`;

    return { ethText, weiHex, paymentUri, qrUrl, rateText };
  };

  const setFeedback = (text) => {
    if (!(feedback instanceof HTMLElement)) return;
    const message = String(text ?? "").trim();
    feedback.hidden = message.length === 0;
    if (!message) {
      feedback.textContent = "";
      return;
    }
    feedback.textContent = text;
  };

  const activateFallback = ({ reason, plan, ntdAmount, fallbackLabel }) => {
    if (!(payButton instanceof HTMLButtonElement)) return;
    payButton.dataset.mode = "fallback";
    payButton.textContent = fallbackLabel;

    if (fallbackBox instanceof HTMLElement) {
      fallbackBox.hidden = false;
    }
    fallbackLinks?.forEach((element) => {
      if (element instanceof HTMLAnchorElement) {
        element.href = plan.paymentUri;
      }
    });
    if (fallbackQr instanceof HTMLImageElement) {
      fallbackQr.src = plan.qrUrl;
    }

    track("Tip Fallback Activated", {
      reason,
      ntd_amount: ntdAmount,
      eth_amount: plan.ethText
    });
    setFeedback(`已切換備援：${reason}。本次約 ${plan.ethText} ETH（約 NT$${ntdAmount}）。${plan.rateText}`);
  };

  payButton?.addEventListener("click", async () => {
    if (!(payButton instanceof HTMLButtonElement)) return;

    const mode = payButton.dataset.mode || "wallet";
    const defaultLabel = payButton.dataset.defaultLabel || "用以太幣抖內（約 NT$100）";
    const fallbackLabel = payButton.dataset.fallbackLabel || "改用錢包連結抖內（約 NT$100）";
    setFeedback("");

    if (mode === "fallback") {
      const link = tipRoot?.querySelector("[data-tip-fallback-link]");
      if (link instanceof HTMLAnchorElement) {
        track("Tip Fallback Opened", { source: "primary_button" });
        window.location.href = link.href;
      }
      return;
    }

    const tipAddress = String(payButton.dataset.tipAddress || payButton.dataset.address || "").trim();
    const tipTarget = String(payButton.dataset.tipTarget || payButton.dataset.target || "").trim();
    const chainId = Number.parseInt(String(payButton.dataset.tipChainId || payButton.dataset.chainId || "1"), 10) || 1;
    const chainIdHex = `0x${chainId.toString(16)}`;
    const ntdAmount = Number.parseInt(String(payButton.dataset.tipNtd || payButton.dataset.ntd || "100"), 10) || 100;
    const fallbackEth = Number.parseFloat(String(payButton.dataset.tipDefaultEth || payButton.dataset.defaultEth || "0.001")) || 0.001;
    track("Tip Attempt", { source: "primary_button", ntd_amount: ntdAmount });

    payButton.disabled = true;
    payButton.textContent = "啟動錢包中...";

    const plan = await buildPaymentPlan({ target: tipTarget, chainId, ntdAmount, fallbackEth });

    try {
      const ethereumProvider = window.ethereum;
      if (!ethereumProvider || typeof ethereumProvider.request !== "function") {
        throw new Error("未偵測到 MetaMask");
      }
      if (!isHexAddress(tipAddress)) {
        throw new Error("無法取得有效收款地址");
      }

      await ethereumProvider.request({ method: "eth_requestAccounts" });
      const activeChainId = await ethereumProvider.request({ method: "eth_chainId" });
      if (activeChainId !== chainIdHex) {
        await ethereumProvider.request({
          method: "wallet_switchEthereumChain",
          params: [{ chainId: chainIdHex }]
        });
      }

      await ethereumProvider.request({
        method: "eth_sendTransaction",
        params: [{ to: tipAddress, value: plan.weiHex }]
      });

      track("Tip Wallet Success", {
        ntd_amount: ntdAmount,
        eth_amount: plan.ethText,
        chain_id: chainId
      });
      setFeedback(`已送出 ${plan.ethText} ETH（約 NT$${ntdAmount}），請在 MetaMask 確認。`);
      payButton.textContent = "已送出，請到錢包確認";
      window.setTimeout(() => {
        payButton.textContent = defaultLabel;
      }, 2200);
    } catch (error) {
      const reason = error instanceof Error ? error.message : "MetaMask 啟動失敗";
      track("Tip Wallet Failed", {
        reason,
        ntd_amount: ntdAmount,
        eth_amount: plan.ethText
      });
      activateFallback({ reason, plan, ntdAmount, fallbackLabel });
    } finally {
      payButton.disabled = false;
    }
  });
</script>

<style>
  .tip-jar-disclosure {
    margin-top: 0;
  }

  .tip-jar-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    list-style: none;
  }

  .tip-jar-summary::-webkit-details-marker {
    display: none;
  }

  .tip-jar-disclosure[open] .tip-jar-summary {
    background: #ebf6f2;
    border-color: #a7cdc3;
    border-radius: 0.9rem 0.9rem 0 0;
    border-bottom: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .tip-jar {
    margin-top: -1px;
    border: 1px solid #c8d9d3;
    border-top: 0;
    border-radius: 0.9rem;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    background: #f5fbf9;
    padding: 0.84rem;
  }

  .tip-jar-line {
    margin: 0;
    font-size: 0.88rem;
    color: #2b3f48;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.38rem;
  }

  .tip-ens-row {
    justify-content: flex-start;
    gap: 0.42rem;
  }

  .tip-ens-text {
    color: #1f3f4d;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .tip-ens-name {
    color: #173744;
    font-size: 0.8rem;
    line-height: 1;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .tip-verified-inline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #0d6f61;
  }

  .tip-verified-inline svg {
    width: 0.98rem;
    height: 0.98rem;
    display: block;
    fill: currentColor;
  }

  .tip-status-inline {
    color: #7f5a1c;
    font-size: 0.76rem;
    line-height: 1.4;
  }

  .tip-actions {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 0.72rem;
  }

  .tip-pay-btn {
    border: 1px solid #c7d8d2;
    border-radius: 0.62rem;
    padding: 0.36rem 0.68rem;
    background: #ffffff;
    color: #2f5664;
    text-decoration: none;
    font-size: 0.82rem;
    cursor: pointer;
    text-align: center;
    min-height: 2.1rem;
  }

  .tip-pay-btn:hover {
    color: #0b7d6d;
    border-color: #98d4c8;
    background: #eef8f4;
  }

  .tip-pay-btn[disabled] {
    opacity: 0.65;
    cursor: wait;
  }

  .tip-pay-feedback {
    margin: 0;
    color: #46616b;
    font-size: 0.76rem;
    line-height: 1.4;
    text-align: center;
  }

  .tip-fallback {
    margin-top: 0.62rem;
    border-top: 1px dashed #c8ddd7;
    padding-top: 0.62rem;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.46rem;
  }

  .tip-qr-caption {
    margin: 0;
    color: #335965;
    font-size: 0.8rem;
  }

  .tip-qr-link {
    display: inline-block;
    border: 1px solid #d1dfdb;
    border-radius: 0.8rem;
    padding: 0.45rem;
    background: #fff;
  }
</style>
