---
import { withBase } from "@/utils/paths";

const pathname = Astro.url.pathname;
const isResearch = pathname.startsWith(withBase("research/"));

const mainLinks = [
  { href: withBase("about/"), label: "關於" },
  { href: withBase("blog/"), label: "文章" },
  { href: withBase("tags/"), label: "標籤" },
  { href: withBase("search/"), label: "搜尋" }
];

const researchLinks = [
  { href: withBase(""), label: "主站" },
  { href: withBase("research/"), label: "研究目錄" },
  { href: withBase("research/tags-graph/"), label: "研究圖譜" },
  { href: withBase("research/search/"), label: "研究搜尋" },
];

const links = isResearch ? researchLinks : mainLinks;

const isActive = (href: string): boolean => {
  return pathname === href || (href !== withBase("") && pathname.startsWith(href));
};

const drawerPartialURL = withBase("partials/social-drawer/");
---

<header class="site-header">
  <div class="container site-header-inner">
    <a class="brand-link" href={withBase("")}>小梅子 / <span class="brand-sub">Jacob Mei Labs</span></a>
    <div class="site-nav-wrap">
      <nav class="site-nav" aria-label="主選單">
        <ul class="nav-list">
          {
            links.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={{
                    "nav-link": true,
                    "nav-link-active": isActive(item.href)
                  }}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <span class="nav-social-divider" aria-hidden="true"></span>
      <div class="nav-social-item">
        <button
          type="button"
          class="nav-social-toggle"
          aria-expanded="false"
          aria-controls="header-social-drawer"
        >
          加我好友
        </button>
        <div class="nav-social-backdrop" hidden></div>
        <div
          id="header-social-drawer"
          class="nav-social-drawer"
          data-partial-src={drawerPartialURL}
          hidden
        ></div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const mq = window.matchMedia("(max-width: 760px)");
  const toggle = document.querySelector(".nav-social-toggle");
  const backdrop = document.querySelector(".nav-social-backdrop");
  const drawer = document.querySelector("#header-social-drawer");

  if (
    toggle instanceof HTMLButtonElement &&
    backdrop instanceof HTMLElement &&
    drawer instanceof HTMLElement
  ) {
    const partialSrc = drawer.dataset.partialSrc ?? "";
    let partialLoaded = false;
    let partialLoading = null;

    const loadPartial = async () => {
      if (partialLoaded) return;
      if (partialLoading) return partialLoading;
      if (!partialSrc) return;
      partialLoading = (async () => {
        try {
          const res = await fetch(partialSrc);
          if (!res.ok) throw new Error(`status ${res.status}`);
          const html = (await res.text()).replace(/^\s*<!DOCTYPE[^>]*>\s*/i, "");
          drawer.innerHTML = html;
          partialLoaded = true;
          const closeBtn = drawer.querySelector(".nav-social-close");
          if (closeBtn instanceof HTMLButtonElement) {
            closeBtn.addEventListener("click", () => setOpen(false));
          }
        } catch (err) {
          console.warn("[header] social drawer partial failed:", err);
          drawer.innerHTML = '<p style="padding:1rem;">載入失敗，請稍後再試。</p>';
        } finally {
          partialLoading = null;
        }
      })();
      return partialLoading;
    };

    const setOpen = (isOpen) => {
      toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
      drawer.hidden = !isOpen;
      backdrop.hidden = !isOpen || !mq.matches;
      document.body.classList.toggle("nav-drawer-open", isOpen && mq.matches);
    };

    const closeDrawer = () => setOpen(false);

    toggle.addEventListener("click", async () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      if (!expanded) await loadPartial();
      setOpen(!expanded);
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (mq.matches) return;
      if (toggle.contains(target) || drawer.contains(target)) return;
      closeDrawer();
    });

    backdrop.addEventListener("click", closeDrawer);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeDrawer();
    });

    mq.addEventListener("change", closeDrawer);
    closeDrawer();
  }
</script>
