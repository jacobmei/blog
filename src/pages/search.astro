---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/paths";
---

<BaseLayout title="搜尋" description="搜尋站內文章與頁面內容。">
  <h1 class="section-title">搜尋</h1>
  <p class="search-intro">快速查找全站文章與頁面內容。</p>

  <section
    class="search-panel"
    aria-label="站內搜尋"
    data-minisearch-url={withBase("search-minisearch.json")}
    data-fallback-url={withBase("search-index.json")}
  >
    <div id="search-state-stack" class="search-state-stack" aria-live="polite">
      <p class="search-state" data-state="loading" hidden>搜尋索引載入中...</p>
      <p class="search-state" data-state="idle" hidden>請輸入關鍵字開始搜尋。</p>
      <p class="search-state" data-state="empty" hidden>找不到符合的結果，請換個關鍵字。</p>
      <p class="search-state search-state-error" data-state="error" hidden>
        搜尋暫時不可用，請稍後再試。
      </p>
    </div>
    <form id="site-search-form" class="search-form" role="search">
      <label for="site-search-input">關鍵字</label>
      <div class="search-form-row">
        <input
          id="site-search-input"
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder="例如：靈修、openclaw、Kindle、電子書"
        />
        <button type="submit" class="nav-link">搜尋</button>
      </div>
    </form>
    <div class="search-fallback-toolbar" role="group" aria-label="搜尋資訊">
      <p id="site-search-count" class="search-result-count">請輸入關鍵字開始搜尋。</p>
    </div>
    <ul id="site-search-results" class="search-results"></ul>
  </section>
  <p class="search-graph-cta">
    <a class="search-graph-cta-link" href={withBase("tags-graph/")}>小梅子的文章關聯圖</a>
  </p>
</BaseLayout>

<script>
  import MiniSearch from "minisearch";

  const panel = document.querySelector(".search-panel") as HTMLElement;
  const minisearchIndexUrl = panel.dataset.minisearchUrl!;
  const fallbackIndexUrl = panel.dataset.fallbackUrl!;

  const track = (name: string, props: Record<string, string> = {}) => {
    if (typeof (window as any).mbTrack === "function") (window as any).mbTrack(name, props);
  };

  const query = new URLSearchParams(window.location.search).get("q") ?? "";
  const form = document.querySelector("#site-search-form");
  const input = document.querySelector("#site-search-input") as HTMLInputElement | null;
  const resultsList = document.querySelector("#site-search-results")!;
  const countEl = document.querySelector("#site-search-count");
  const stateNodes = Array.from(document.querySelectorAll(".search-state"));
  let currentMode = "minisearch";

  const setSearchState = (nextState: string) => {
    stateNodes.forEach((node) => {
      if (!(node instanceof HTMLElement)) return;
      node.hidden = node.dataset.state !== nextState;
    });
  };

  const normalize = (value: string) => value.toLocaleLowerCase("zh-TW").normalize("NFKC").trim();
  const escapeHTML = (value: string) =>
    value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

  const highlight = (value: string, tokens: string[]) => {
    const safe = escapeHTML(value ?? "");
    if (!tokens.length) return safe;
    const pattern = tokens
      .filter((token) => token.length >= 2)
      .map((token) => escapeRegExp(token))
      .join("|");
    if (!pattern) return safe;
    return safe.replace(new RegExp(`(${pattern})`, "gi"), "<mark>$1</mark>");
  };

  const formatDate = (raw: string | undefined) => {
    if (!raw) return "";
    const date = new Date(raw);
    if (Number.isNaN(date.getTime())) return "";
    return new Intl.DateTimeFormat("zh-TW", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(date);
  };

  const isCJK = (ch: string) => {
    const cp = ch.codePointAt(0)!;
    return (cp >= 0x4e00 && cp <= 0x9fff) || (cp >= 0x3400 && cp <= 0x4dbf);
  };

  const queryBigrams = (text: string): string[] => {
    const normalized = normalize(text);
    const segments = normalized.split(/\s+/).filter(Boolean);
    const tokens: string[] = [];
    for (const seg of segments) {
      const chars = [...seg];
      const hasCJK = chars.some((ch) => isCJK(ch));
      if (!hasCJK) {
        tokens.push(seg);
        continue;
      }
      if (chars.length === 1) {
        tokens.push(chars[0]);
      } else {
        for (let i = 0; i < chars.length - 1; i++) {
          tokens.push(chars[i] + chars[i + 1]);
        }
      }
    }
    return tokens;
  };

  const detectHitZones = (doc: any, tokens: string[]) => {
    const zones: string[] = [];
    const titleText = normalize(doc.title ?? "");
    const descText = normalize(doc.description ?? "");
    const bodyText = normalize(doc.content ?? "");
    const tagText = normalize((doc.tags ?? []).join(" "));
    if (tokens.some((t) => titleText.includes(t))) zones.push("標題");
    if (tokens.some((t) => descText.includes(t))) zones.push("摘要");
    if (tokens.some((t) => bodyText.includes(t))) zones.push("內文");
    if (tokens.some((t) => tagText.includes(t))) zones.push("標籤");
    return zones;
  };

  const renderResults = (items: any[], q: string) => {
    resultsList.innerHTML = "";
    const tokens = queryBigrams(q);

    if (!q.trim()) {
      setSearchState("idle");
      if (countEl) countEl.textContent = "請輸入關鍵字開始搜尋。";
      return;
    }
    if (items.length === 0) {
      setSearchState("empty");
      if (countEl) countEl.textContent = "0 筆結果";
      return;
    }

    setSearchState("ready");
    if (countEl) countEl.textContent = `${items.length} 筆結果`;

    for (const item of items) {
      const dateLabel = formatDate(item.pubDate);
      const topics = Array.isArray(item.topics) ? item.topics.slice(0, 3) : [];
      const tags = Array.isArray(item.tags)
        ? item.tags.filter((tag: string) => !topics.includes(tag)).slice(0, 4)
        : [];
      const hitZones = detectHitZones(item, tokens);
      const metaParts = ["文章", dateLabel].filter(Boolean);
      const li = document.createElement("li");
      li.className = "search-result-item";
      li.innerHTML = `
        <div class="search-result-top">
          <a class="search-result-link" href="${item.url}">${highlight(item.title, tokens)}</a>
          <span class="search-result-meta">${metaParts.join(" · ")}</span>
        </div>
        ${
          hitZones.length > 0
            ? `<p class="search-hit-zone">命中：${hitZones.map((zone: string) => `<span>${zone}</span>`).join("")}</p>`
            : ""
        }
        <p class="search-result-snippet">${highlight(item.description ?? "", tokens)}</p>
        ${
          topics.length > 0 || tags.length > 0
            ? `<ul class="search-result-tags">
                ${topics.map((tag: string) => `<li class="search-result-tag-topic">${highlight(tag, tokens)}</li>`).join("")}
                ${tags.map((tag: string) => `<li class="search-result-tag-keyword">${highlight(tag, tokens)}</li>`).join("")}
              </ul>`
            : ""
        }
      `;
      resultsList.appendChild(li);
    }
  };

  /* ── Fallback: raw JSON search (no MiniSearch) ── */
  const scoreDoc = (doc: any, tokens: string[]) => {
    const titleText = normalize(doc.title ?? "");
    const descText = normalize(doc.description ?? "");
    const bodyText = normalize(doc.content ?? "");
    const tagText = normalize((doc.tags ?? []).join(" "));
    let score = 0;
    for (const token of tokens) {
      if (titleText.includes(token)) score += 6;
      if (tagText.includes(token)) score += 4;
      if (descText.includes(token)) score += 2;
      if (bodyText.includes(token)) score += 1;
    }
    return score;
  };

  const runFallbackSearch = async () => {
    currentMode = "fallback";
    let docs: any[] = [];
    try {
      const res = await fetch(fallbackIndexUrl, { headers: { accept: "application/json" } });
      if (!res.ok) throw new Error(`Load failed: ${res.status}`);
      docs = await res.json();
    } catch (error) {
      setSearchState("error");
      console.error("[search] fallback index load failed:", error);
      return;
    }

    const doSearch = (q: string) => {
      const tokens = queryBigrams(q);
      if (tokens.length === 0) {
        renderResults([], "");
        return;
      }
      const ranked = docs
        .map((doc) => ({ doc, score: scoreDoc(doc, tokens) }))
        .filter((item) => item.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 80)
        .map((item) => item.doc);
      renderResults(ranked, q);
    };

    setSearchState("idle");
    bindSearchEvents(doSearch);
    doSearch(query);
  };

  /* ── Bind search form events ── */
  const bindSearchEvents = (searchFn: (q: string) => void) => {
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const q = input?.value.trim() ?? "";
      track("Search Used", { mode: currentMode, query_length: String(q.length) });
      searchFn(q);
    });

    input?.addEventListener("input", () => {
      searchFn(input.value.trim());
    });

    resultsList?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const link = target.closest(".search-result-link");
      if (!(link instanceof HTMLAnchorElement)) return;
      track("Search Result Click", { mode: currentMode });
    });

    if (input) {
      input.value = query;
      input.focus();
    }
  };

  /* ── Main: try MiniSearch, fallback to JSON ── */
  (async () => {
    setSearchState("loading");

    try {
      const res = await fetch(minisearchIndexUrl);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const indexData = await res.json();

      const miniSearch = MiniSearch.loadJSON(JSON.stringify(indexData), {
        idField: "id",
        fields: ["title_bigrams", "desc_bigrams", "content_bigrams", "tags_bigrams"],
        storeFields: ["title", "description", "url", "pubDate", "tags", "topics"],
        tokenize: (text: string) => text.split(/\s+/).filter(Boolean),
        searchOptions: {
          boost: { title_bigrams: 6, tags_bigrams: 4, desc_bigrams: 2, content_bigrams: 1 },
          prefix: true,
        },
      });

      const doSearch = (q: string) => {
        const trimmed = q.trim();
        if (!trimmed) {
          renderResults([], "");
          return;
        }
        const bigrams = queryBigrams(trimmed);
        const results = miniSearch.search(bigrams.join(" "), { limit: 80 });
        renderResults(results, trimmed);
      };

      setSearchState("idle");
      bindSearchEvents(doSearch);
      doSearch(query);
    } catch (error) {
      console.warn("[search] MiniSearch init failed, falling back to JSON:", error);
      await runFallbackSearch();
    }
  })();
</script>
