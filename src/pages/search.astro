---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/paths";

const pagefindScriptUrl = withBase("pagefind/pagefind-ui.js");
const pagefindStyleUrl = withBase("pagefind/pagefind-ui.css");
const fallbackIndexUrl = withBase("search-index.json");
---

<BaseLayout title="搜尋" description="搜尋站內文章與頁面內容。">
  <h1 class="section-title">搜尋</h1>
  <p class="search-intro">快速查找全站文章與頁面內容。</p>

  <section class="search-panel" aria-label="站內搜尋">
    <p id="pagefind-status" class="search-status" aria-live="polite" hidden></p>
    <div id="search-state-stack" class="search-state-stack" aria-live="polite">
      <p class="search-state" data-state="loading" hidden>搜尋索引載入中...</p>
      <p class="search-state" data-state="idle" hidden>請輸入關鍵字開始搜尋。</p>
      <p class="search-state" data-state="empty" hidden>找不到符合的結果，請換個關鍵字。</p>
      <p class="search-state search-state-error" data-state="error" hidden>
        搜尋暫時不可用，請稍後再試。
      </p>
    </div>
    <div id="pagefind-search"></div>
    <div id="search-fallback" class="search-fallback" hidden>
      <form id="site-search-form" class="search-form" role="search">
        <label for="site-search-input">關鍵字</label>
        <div class="search-form-row">
          <input
            id="site-search-input"
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder="例如：隱私、Matters、d/acc、2024"
          />
          <button type="submit" class="nav-link">搜尋</button>
        </div>
      </form>
      <div class="search-fallback-toolbar" role="group" aria-label="搜尋篩選">
        <p id="site-search-count" class="search-result-count">請輸入關鍵字開始搜尋。</p>
        <div class="search-type-filter">
          <button type="button" class="search-filter-btn is-active" data-type="all">全部</button>
          <button type="button" class="search-filter-btn" data-type="post">文章</button>
          <button type="button" class="search-filter-btn" data-type="page">頁面</button>
        </div>
      </div>
      <ul id="site-search-results" class="search-results"></ul>
    </div>
  </section>
  <p class="search-graph-cta">
    <a class="search-graph-cta-link" href={withBase("tags-graph/")}>與豆泥的大腦互動（實驗版）</a>
  </p>
</BaseLayout>

<script is:inline define:vars={{ pagefindScriptUrl, pagefindStyleUrl, fallbackIndexUrl }}>
  const track = (name, props = {}) => {
    if (typeof window.mbTrack === "function") window.mbTrack(name, props);
  };

  const status = document.querySelector("#pagefind-status");
  const searchRoot = document.querySelector("#pagefind-search");
  const query = new URLSearchParams(window.location.search).get("q") ?? "";
  const fallbackRoot = document.querySelector("#search-fallback");
  const fallbackForm = document.querySelector("#site-search-form");
  const fallbackInput = document.querySelector("#site-search-input");
  const fallbackResults = document.querySelector("#site-search-results");
  const fallbackCount = document.querySelector("#site-search-count");
  const typeButtons = Array.from(document.querySelectorAll(".search-filter-btn"));
  const stateNodes = Array.from(document.querySelectorAll(".search-state"));
  let activeType = "all";
  let currentSearchMode = "pagefind";

  const setSearchState = (nextState) => {
    stateNodes.forEach((node) => {
      if (!(node instanceof HTMLElement)) return;
      node.hidden = node.dataset.state !== nextState;
    });
  };

  const setStatus = (message = "") => {
    if (!(status instanceof HTMLElement)) return;
    status.textContent = message;
    status.hidden = message.length === 0;
  };

  const loadScript = (src) =>
    new Promise((resolve, reject) => {
      const tag = document.createElement("script");
      tag.src = src;
      tag.async = true;
      tag.onload = () => resolve(true);
      tag.onerror = () => reject(new Error(`Unable to load ${src}`));
      document.head.appendChild(tag);
    });

  const loadStylesheet = (href) => {
    if (document.querySelector(`link[data-pagefind=\"${href}\"]`)) return;
    const link = document.createElement("link");
    link.rel = "stylesheet";
    link.href = href;
    link.dataset.pagefind = href;
    document.head.appendChild(link);
  };

  const normalize = (value) => value.toLocaleLowerCase("zh-TW").normalize("NFKC").trim();
  const tokenize = (value) => normalize(value).split(/\s+/).filter(Boolean);
  const escapeHTML = (value) =>
    value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  const escapeRegExp = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

  const highlight = (value, tokens) => {
    const safe = escapeHTML(value ?? "");
    if (!tokens.length) return safe;
    const pattern = tokens
      .filter((token) => token.length >= 2)
      .map((token) => escapeRegExp(token))
      .join("|");
    if (!pattern) return safe;
    return safe.replace(new RegExp(`(${pattern})`, "gi"), "<mark>$1</mark>");
  };

  const scoreDoc = (doc, tokens) => {
    const titleText = normalize(doc.title ?? "");
    const descText = normalize(doc.description ?? "");
    const bodyText = normalize(doc.content ?? "");
    const tagText = normalize((doc.tags ?? []).join(" "));
    let score = 0;
    for (const token of tokens) {
      if (titleText.includes(token)) score += 6;
      if (tagText.includes(token)) score += 4;
      if (descText.includes(token)) score += 2;
      if (bodyText.includes(token)) score += 1;
    }
    return score;
  };

  const detectHitZones = (doc, tokens) => {
    const zones = [];
    const titleText = normalize(doc.title ?? "");
    const descText = normalize(doc.description ?? "");
    const bodyText = normalize(doc.content ?? "");
    const tagText = normalize((doc.tags ?? []).join(" "));

    if (tokens.some((token) => titleText.includes(token))) zones.push("標題");
    if (tokens.some((token) => descText.includes(token))) zones.push("摘要");
    if (tokens.some((token) => bodyText.includes(token))) zones.push("內文");
    if (tokens.some((token) => tagText.includes(token))) zones.push("標籤");
    return zones;
  };

  const formatDate = (raw) => {
    if (!raw) return "";
    const date = new Date(raw);
    if (Number.isNaN(date.getTime())) return "";
    return new Intl.DateTimeFormat("zh-TW", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(date);
  };

  const runFallbackSearch = async () => {
    currentSearchMode = "fallback";
    fallbackRoot.hidden = false;
    setSearchState("loading");

    let docs = [];
    try {
      const res = await fetch(fallbackIndexUrl, { headers: { accept: "application/json" } });
      if (!res.ok) throw new Error(`Load failed: ${res.status}`);
      docs = await res.json();
      setStatus("");
    } catch (error) {
      setSearchState("error");
      setStatus("搜尋索引載入失敗，請稍後再試。");
      console.error("[search-fallback] load index failed:", error);
      return;
    }

    const renderResults = (items, q) => {
      fallbackResults.innerHTML = "";
      const tokens = tokenize(q);

      if (!q) {
        setSearchState("idle");
        return;
      }
      if (items.length === 0) {
        setSearchState("empty");
        fallbackResults.innerHTML = `<li class="search-result-item">找不到符合的結果。</li>`;
        if (fallbackCount) fallbackCount.textContent = "0 筆結果";
        return;
      }

      setSearchState("ready");
      if (fallbackCount) fallbackCount.textContent = `${items.length} 筆結果`;

      for (const item of items) {
        const typeLabel = item.type === "post" ? "文章" : "頁面";
        const dateLabel = item.type === "post" ? formatDate(item.pubDate) : "";
        const topics = Array.isArray(item.topics) ? item.topics.slice(0, 3) : [];
        const tags = Array.isArray(item.tags)
          ? item.tags.filter((tag) => !topics.includes(tag)).slice(0, 4)
          : [];
        const hitZones = detectHitZones(item, tokens);
        const metaParts = [typeLabel, dateLabel].filter(Boolean);
        const li = document.createElement("li");
        li.className = "search-result-item";
        li.innerHTML = `
          <div class="search-result-top">
            <a class="search-result-link" href="${item.url}">${highlight(item.title, tokens)}</a>
            <span class="search-result-meta">${metaParts.join(" · ")}</span>
          </div>
          ${
            hitZones.length > 0
              ? `<p class="search-hit-zone">命中：${hitZones.map((zone) => `<span>${zone}</span>`).join("")}</p>`
              : ""
          }
          <p class="search-result-snippet">${highlight(item.description ?? "", tokens)}</p>
          ${
            topics.length > 0 || tags.length > 0
              ? `<ul class="search-result-tags">
                  ${topics.map((tag) => `<li class="search-result-tag-topic">${highlight(tag, tokens)}</li>`).join("")}
                  ${tags.map((tag) => `<li class="search-result-tag-keyword">${highlight(tag, tokens)}</li>`).join("")}
                </ul>`
              : ""
          }
        `;
        fallbackResults.appendChild(li);
      }
    };

    const search = (q) => {
      const tokens = tokenize(q);
      if (tokens.length === 0) {
        renderResults([], "");
        if (fallbackCount) fallbackCount.textContent = "請輸入關鍵字開始搜尋。";
        return;
      }

      const ranked = docs
        .map((doc) => ({ doc, score: scoreDoc(doc, tokens) }))
        .filter((item) => item.score > 0)
        .filter((item) => activeType === "all" || item.doc.type === activeType)
        .sort((a, b) => b.score - a.score)
        .slice(0, 80)
        .map((item) => item.doc);

      renderResults(ranked, q);
    };

    fallbackForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const q = fallbackInput?.value.trim() ?? "";
      track("Search Used", {
        mode: "fallback",
        query_length: String(q.length),
        filter: activeType,
      });
      search(q);
    });

    fallbackInput?.addEventListener("input", () => {
      const q = fallbackInput.value.trim();
      search(q);
    });

    typeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const nextType = button.dataset.type ?? "all";
        activeType = nextType;
        typeButtons.forEach((item) => item.classList.toggle("is-active", item === button));
        const q = fallbackInput?.value.trim() ?? "";
        search(q);
      });
    });

    if (fallbackInput) {
      fallbackInput.value = query;
      fallbackInput.focus();
    }

    fallbackResults?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const link = target.closest(".search-result-link");
      if (!(link instanceof HTMLAnchorElement)) return;
      track("Search Result Click", { mode: "fallback" });
    });
    search(query);
  };

  (async () => {
    setSearchState("loading");
    try {
      loadStylesheet(pagefindStyleUrl);
      await loadScript(pagefindScriptUrl);
      if (!window.PagefindUI || !searchRoot) throw new Error("PagefindUI unavailable");

      const ui = new window.PagefindUI({
        element: "#pagefind-search",
        showSubResults: true,
        showImages: false,
        excerptLength: 16,
        resetStyles: false,
        translations: {
          placeholder: "輸入關鍵字搜尋文章",
          clear_search: "清除搜尋",
          load_more: "載入更多結果",
          search_label: "搜尋站內內容",
          zero_results: "找不到符合的結果",
          many_results: "[COUNT] 筆結果",
          one_result: "[COUNT] 筆結果",
          searching: "搜尋中...",
        },
      });
      setStatus("");

      if (query) {
        await ui.triggerSearch(query);
      }

      setTimeout(() => {
        const input = document.querySelector(".pagefind-ui__search-input");
        if (input instanceof HTMLInputElement) {
          if (query) input.value = query;
          input.focus();
          input.addEventListener("keydown", (event) => {
            if (event.key !== "Enter") return;
            const q = input.value.trim();
            if (!q) return;
            track("Search Used", {
              mode: "pagefind",
              query_length: String(q.length),
              filter: "all",
            });
          });
          input.addEventListener("input", () => {
            if (currentSearchMode !== "pagefind") return;
            if (!input.value.trim()) setSearchState("idle");
          });
        }
      }, 0);

      const syncPagefindState = () => {
        if (currentSearchMode !== "pagefind") return;
        const input = document.querySelector(".pagefind-ui__search-input");
        const keyword = input instanceof HTMLInputElement ? input.value.trim() : query;
        if (!keyword) {
          setSearchState("idle");
          return;
        }
        const resultCount = document.querySelectorAll(".pagefind-ui__result").length;
        const isSearching = Boolean(document.querySelector(".pagefind-ui__message"));
        if (resultCount > 0) {
          setSearchState("ready");
        } else if (isSearching) {
          const message =
            document.querySelector(".pagefind-ui__message")?.textContent?.trim() ?? "";
          if (message.includes("找不到")) setSearchState("empty");
          else setSearchState("loading");
        } else {
          setSearchState("empty");
        }
      };

      const observer = new MutationObserver(() => syncPagefindState());
      observer.observe(searchRoot, { childList: true, subtree: true });
      searchRoot.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const link = target.closest(".pagefind-ui__result-link");
        if (!(link instanceof HTMLAnchorElement)) return;
        track("Search Result Click", { mode: "pagefind" });
      });
      syncPagefindState();
    } catch (error) {
      console.warn("[pagefind] init failed, falling back to JSON search:", error);
      await runFallbackSearch();
      console.error("[pagefind] init failed:", error);
    }
  })();
</script>
