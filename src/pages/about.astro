---
import BaseLayout from "@/layouts/BaseLayout.astro";

const contactLinks = [
  { label: "Email", href: "mailto:jacobmei@gmail.com" },
  { label: "Facebook", href: "https://www.facebook.com/jacob.mei" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/jacobmei/" },
  { label: "Twitter/X", href: "https://x.com/macdog" },
  { label: "Threads", href: "https://www.threads.net/@macdog" }
];
---

<BaseLayout title="關於我 / About" description="梅驊（Jacob Mei）的個人簡介，資訊與金融跨域工作者。">
  <section class="about-lang-switch" aria-label="語言切換">
    <button type="button" class="about-lang-btn is-active" data-lang="zh">中文</button>
    <button type="button" class="about-lang-btn" data-lang="en">English</button>
  </section>

  <article class="about-cv" data-lang-content="zh">
    <header class="about-cv-header">
      <p class="about-cv-kicker">關於我</p>
      <h1 class="about-cv-name">梅驊 Jacob Mei</h1>
      <p class="about-cv-summary">
        資訊背景出身，曾在新浪網、PChome、eBay 等電子商務產業深耕近 20 年。2010 年因緣際會踏入金融業，先後擔任永豐銀行電子金融處處長、永豐創投董事。2018 年投入純網銀籌設，2022 年加入街口支付擔任董事長，深度參與台灣數位金融、電子支付與數位資產相關法規與應用場景。
      </p>
      <p class="about-cv-summary">
        這些年的工作歷程，深刻體會人的能力與資源都有極限。唯有基督信仰是我真正的力量，幫助我在困境中尋求神的智慧，榮神益人。
      </p>
      <ul class="about-cv-links">
        {contactLinks.map((item) => <li><a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a></li>)}
      </ul>
    </header>

    <section class="about-cv-section">
      <h2>工作經歷</h2>
      <div class="about-cv-entry">
        <div class="about-cv-entry-head">
          <h3>街口支付｜董事長</h3>
          <p>台灣 · 2022 - 至今</p>
        </div>
        <ul>
          <li>領導台灣主要電子支付平台，推動數位支付普及與法規倡議。</li>
          <li>深度參與電子支付、數位資產等相關法規制定與應用場景開發。</li>
        </ul>
      </div>
      <div class="about-cv-entry">
        <div class="about-cv-entry-head">
          <h3>將來銀行｜副總經理</h3>
          <p>台灣 · 2018 - 2022</p>
        </div>
        <ul>
          <li>參與台灣首批純網路銀行籌設與營運，推動數位金融創新服務。</li>
        </ul>
      </div>
      <div class="about-cv-entry">
        <div class="about-cv-entry-head">
          <h3>永豐銀行｜電子金融處處長 / 永豐創投｜董事</h3>
          <p>台灣 · 2010 - 2018</p>
        </div>
        <ul>
          <li>主導銀行數位轉型，建置電子金融服務體系。</li>
          <li>擔任創投基金董事，參與科技與金融新創投資決策。</li>
        </ul>
      </div>
      <div class="about-cv-entry">
        <div class="about-cv-entry-head">
          <h3>新浪網 / PChome / eBay｜電子商務</h3>
          <p>台灣 · 約 1990s - 2010</p>
        </div>
        <ul>
          <li>橫跨入口網站、電商平台與跨境電商，累積近 20 年數位產業經驗。</li>
        </ul>
      </div>
    </section>
  </article>

  <article class="about-cv" data-lang-content="en" hidden>
    <header class="about-cv-header">
      <p class="about-cv-kicker">About</p>
      <h1 class="about-cv-name">Jacob Mei</h1>
      <p class="about-cv-summary">
        With a background in information technology, I spent nearly 20 years in e-commerce at companies including Sina, PChome, and eBay. In 2010, I transitioned into finance, serving as EVP of Digital Banking at Sinopac Bank and as a board director at Sinopac Ventures. In 2018, I participated in the founding of a neobank in Taiwan, and in 2022 joined JKoPay as Chairman, deeply engaged in Taiwan's digital finance, e-payment regulations, and digital asset ecosystem.
      </p>
      <p class="about-cv-summary">
        Through these years, I've learned that human ability and resources have their limits. My Christian faith remains my true source of strength—helping me seek God's wisdom in adversity and live to glorify Him and serve others.
      </p>
      <ul class="about-cv-links">
        {contactLinks.map((item) => <li><a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a></li>)}
      </ul>
    </header>

    <section class="about-cv-section">
      <h2>Experience</h2>
      <div class="about-cv-entry">
        <div class="about-cv-entry-head">
          <h3>JKoPay · Chairman</h3>
          <p>Taiwan · 2022 - Present</p>
        </div>
        <ul>
          <li>Leading one of Taiwan's major e-payment platforms, driving adoption and regulatory advocacy.</li>
          <li>Actively involved in e-payment and digital asset legislation and use-case development.</li>
        </ul>
      </div>
      <div class="about-cv-entry">
        <div class="about-cv-entry-head">
          <h3>Next Bank (將來銀行) · Deputy General Manager</h3>
          <p>Taiwan · 2018 - 2022</p>
        </div>
        <ul>
          <li>Participated in founding and operations of Taiwan's first neobank, driving digital financial innovation.</li>
        </ul>
      </div>
      <div class="about-cv-entry">
        <div class="about-cv-entry-head">
          <h3>Sinopac Bank · EVP, Digital Banking / Sinopac Ventures · Board Director</h3>
          <p>Taiwan · 2010 - 2018</p>
        </div>
        <ul>
          <li>Led digital transformation of retail banking and built the e-financial services infrastructure.</li>
          <li>Served on the investment committee for fintech and tech startup ventures.</li>
        </ul>
      </div>
      <div class="about-cv-entry">
        <div class="about-cv-entry-head">
          <h3>Sina / PChome / eBay · E-Commerce</h3>
          <p>Taiwan · ~1990s - 2010</p>
        </div>
        <ul>
          <li>Nearly 20 years across internet portals, e-commerce platforms, and cross-border marketplaces.</li>
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>

<script is:inline>
  const langButtons = Array.from(document.querySelectorAll(".about-lang-btn"));
  const langPanels = Array.from(document.querySelectorAll("[data-lang-content]"));
  const storedLang = localStorage.getItem("jacobmei.about.lang");
  const queryLang = new URLSearchParams(window.location.search).get("lang");
  const preferredLang = queryLang === "en" || queryLang === "zh" ? queryLang : storedLang;
  let currentLang = preferredLang === "en" ? "en" : "zh";

  const syncState = (lang) => {
    currentLang = lang;
    langButtons.forEach((button) => button.classList.toggle("is-active", button.dataset.lang === lang));
    langPanels.forEach((panel) => {
      panel.hidden = panel.getAttribute("data-lang-content") !== lang;
    });
    const url = new URL(window.location.href);
    if (lang === "en") url.searchParams.set("lang", "en");
    else url.searchParams.delete("lang");
    window.history.replaceState({}, "", url.toString());
    localStorage.setItem("jacobmei.about.lang", lang);
  };

  langButtons.forEach((button) => {
    button.addEventListener("click", () => syncState(button.dataset.lang === "en" ? "en" : "zh"));
  });

  syncState(currentLang);
</script>
