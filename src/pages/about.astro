      <div class="about-cv-entry">
        <ul>
          <li>Honorable Mention, APRSAF Young Scholar Essay Competition (2023)</li>
          <li>Inter-Asian Studies publication on identity autonomy (2025)</li>
          <li>Inventor, U.S. Patent Application Publication US 2024/0285913 A1</li>
          <li>Winner, Stanford Design Challenge Asia (2019)</li>
          <li>Grand Prize, Smart City Hackathon, Taiwan Industrial Development Bureau (2016)</li>
        </ul>
      </div>
    </section>

    <section class="about-orgs" aria-labelledby="about-orgs-en">
      <div class="about-orgs-head">
        <h2 id="about-orgs-en">Organizations I've Worked With</h2>
      </div>
      <div class="about-org-groups">
        {
          affiliationGroups.map((group) => (
            <section class="about-org-group" aria-label={group.titleEn}>
              <h3>{group.titleEn}</h3>
              <ul class="about-org-grid">
                {
                  group.items.map((org) => (
                    <li class="about-org-card">
                      <a href={org.href} target="_blank" rel="noopener noreferrer">
                        <span class="about-org-logo-wrap">
                          {
                            org.logo ? (
                              org.logoKind === "image" ? (
                                <img
                                  class="about-org-logo-image"
                                  style={`--org-logo-w:${org.logoWidth};--org-logo-filter:${org.logoFilter ?? (org.logoMonochrome === false ? "none" : "brightness(0) saturate(100%) invert(31%) sepia(44%) saturate(915%) hue-rotate(130deg) brightness(95%) contrast(93%)")};`}
                                  src={resolveLogoUrl(org.logo)}
                                  alt=""
                                  loading="lazy"
                                  decoding="async"
                                  aria-hidden="true"
                                />
                              ) : (
                                <span
                                  class="about-org-logo"
                                  style={`--org-logo:url('${resolveLogoUrl(org.logo)}');--org-logo-w:${org.logoWidth};`}
                                  aria-hidden="true"
                                ></span>
                              )
                            ) : (
                              <span class="about-org-logo-fallback" aria-hidden="true">{org.key.toUpperCase()}</span>
                            )
                          }
                        </span>
                        <span class="about-org-name-en">{org.en}</span>
                        <span class="about-org-name-zh">{org.zh}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </section>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>

<script is:inline>
  const langButtons = Array.from(document.querySelectorAll(".about-lang-btn"));
  const langPanels = Array.from(document.querySelectorAll("[data-lang-content]"));
  const queryLang = new URLSearchParams(window.location.search).get("lang");
  const storedLang = localStorage.getItem("mashbean.about.lang");
  const preferredLang = queryLang === "en" || queryLang === "zh" ? queryLang : storedLang;
  let currentLang = preferredLang === "en" ? "en" : "zh";

  const syncState = (lang) => {
    currentLang = lang;
    langButtons.forEach((button) => button.classList.toggle("is-active", button.dataset.lang === lang));
    langPanels.forEach((panel) => {
      const show = panel.getAttribute("data-lang-content") === lang;
      panel.hidden = !show;
    });
    const url = new URL(window.location.href);
    if (lang === "en") url.searchParams.set("lang", "en");
    else url.searchParams.delete("lang");
    window.history.replaceState({}, "", url.toString());
    localStorage.setItem("mashbean.about.lang", lang);
  };

  langButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const next = button.dataset.lang === "en" ? "en" : "zh";
      syncState(next);
    });
  });

  syncState(currentLang);
</script>
