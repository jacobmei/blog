---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildPostUrl, getBlogPosts, getEffectiveDate } from "@/utils/blog";
import { formatDate } from "@/utils/date";
import { classifyPostTags } from "@/utils/blogTags";
import { cleanPostTitle } from "@/utils/title";

const posts = await getBlogPosts();
const yearMap = new Map<number, typeof posts>();

for (const post of posts) {
  const year = getEffectiveDate(post).getFullYear();
  const bucket = yearMap.get(year);
  if (bucket) {
    bucket.push(post);
  } else {
    yearMap.set(year, [post]);
  }
}

const yearSections = Array.from(yearMap.entries())
  .map(([year, yearPosts]) => ({
    year,
    posts: yearPosts,
    count: yearPosts.length,
  }))
  .sort((a, b) => b.year - a.year);

const yearNotes: Record<number, string> = {
  2022: "加入街口支付擔任董事長，深度參與台灣電子支付與數位金融法規",
  2021: "在將來銀行推動純網路銀行創新服務",
  2020: "永豐銀行電子金融處處長、永豐創投董事",
};

const RECENT_UPDATED_DAYS = 90;
const recentThreshold = Date.now() - RECENT_UPDATED_DAYS * 24 * 60 * 60 * 1000;
const isRecentlyUpdated = (pubDate: Date, updatedDate?: Date) => {
  const reference = updatedDate ?? pubDate;
  return reference.getTime() >= recentThreshold;
};

const topicByPostId = new Map<string, string[]>();
for (const post of posts) {
  const classified = classifyPostTags({
    title: cleanPostTitle(post.data.title),
    description: post.data.description,
    body: post.body,
    tags: post.data.tags,
  });
  topicByPostId.set(post.id, classified.topics);
}
---

<BaseLayout title="文章列表" description="依日期由新到舊的所有文章。">
  <h1 class="section-title">文章列表</h1>
  <p>共 {posts.length} 篇，依日期由新到舊。</p>

  {
    posts.length === 0 ? (
      <p class="empty-state">目前還沒有文章。</p>
    ) : (
      <>
        <div class="archive-accordion-list" aria-label="年份文章收合列表">
          {yearSections.map((section, index) => (
            <details class="archive-accordion" open={index === 0}>
              <summary class="archive-accordion-summary">
                <span class="archive-accordion-title">
                  <span class="tag-chip-icon" aria-hidden="true">
                    🗓️
                  </span>
                  {section.year} 年
                </span>
                {yearNotes[section.year] && (
                  <span class="archive-accordion-note">{yearNotes[section.year]}</span>
                )}
                <span class="archive-accordion-count" data-count data-total={section.count}>
                  {section.count} 篇
                </span>
              </summary>
              <div class="archive-accordion-body">
                <div class="archive-accordion-body-inner">
                  <ul class="archive-list">
                    {section.posts.map((post) => {
                      const topics = topicByPostId.get(post.id) ?? ["公共網路"];
                      return (
                        <li class="archive-item">
                          <time class="archive-date" datetime={getEffectiveDate(post).toISOString()}>
                            {formatDate(getEffectiveDate(post))}
                          </time>
                          <div class="archive-main">
                            <a class="archive-link" href={buildPostUrl(post)}>
                              {post.data.featured && <span aria-label="置頂" style="margin-right:0.25rem;">📌</span>}
                              {cleanPostTitle(post.data.title)}
                            </a>
                            <p class="archive-meta">
                              <span class="archive-meta-topics">主題：{topics.join("・")}</span>
                              {isRecentlyUpdated(getEffectiveDate(post), post.data.updatedDate ?? undefined) && (
                                <span
                                  class="archive-update-badge"
                                  title={`近 ${RECENT_UPDATED_DAYS} 天內更新`}
                                >
                                  最近更新
                                </span>
                              )}
                            </p>
                          </div>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </div>
            </details>
          ))}
        </div>
      </>
    )
  }
</BaseLayout>

<script is:inline>
  const track = (name, props = {}) => {
    if (typeof window.mbTrack === "function") window.mbTrack(name, props);
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const link = target.closest(".archive-link");
    if (!(link instanceof HTMLAnchorElement)) return;
    track("Archive Post Click", { source: "blog_archive" });
  });
</script>
