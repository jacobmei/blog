---
import { AUTHOR_PROFILE, SITE_DESCRIPTION, SITE_TITLE } from "@/site.config";
import { withBase } from "@/utils/paths";

const year = new Date().getFullYear();
const links = [
  { href: withBase("subscribe/"), label: "RSS 訂閱" }
];
---

<footer class="site-footer">
  <div class="container">
    <p>
      <strong>小梅子 / Jacob Mei Labs</strong> · {SITE_DESCRIPTION}
    </p>
    <div class="footer-meta-row">
      <p class="footer-links">
        {links.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={`mailto:${AUTHOR_PROFILE.email}`}>聯繫我</a>
      </p>
      <p class="footer-license">
        本站文章皆採
        {" "}
        <a
          href="https://creativecommons.org/licenses/by-nc/4.0/deed.zh-hant"
          target="_blank"
          rel="noopener noreferrer"
        >
          CC BY-NC 4.0（姓名標示-非商業性）
        </a>
        {" "}
        授權。
      </p>
    </div>
    <p>© {year} Jacob Mei. Some rights reserved.</p>

    <address class="footer-contact">
      <strong>小梅子 / Jacob Mei Labs</strong><br />
      研究範疇：電子支付 · 數位金融 · Web3 治理 · AI 代理 · 信仰生活<br />
      聯繫信箱：<a href="mailto:sitedirector@gmail.com">sitedirector@gmail.com</a><br />
      座標：去中心化網路與永續知識庫
    </address>
  </div>
</footer>
